<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <!-- Required elements-->
        <id>espeak-ng</id>
        <version>1.0.1</version>
        <description>A compact open source software text-to-speech synthesizer</description>
        <authors>espeak-ng</authors>
        <dependencies>
            <group targetFramework="net10.0" />
        </dependencies>

        <contentFiles>
            <files include="any/any/espeak-ng-data/**" buildAction="None" copyToOutput="true" flatten="false" />
        </contentFiles>
    </metadata>
    <!-- Optional 'files' node -->
</package>